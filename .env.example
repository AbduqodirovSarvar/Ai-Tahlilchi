# Copy to .env and fill in. Never commit .env.
# Every value is optional at load time; a component that needs a missing key refuses to
# start with a clear message (e.g. the bot needs TELEGRAM_BOT_TOKEN and ADMIN_IDS).

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot
ADMIN_IDS=

# Data sources
API_FOOTBALL_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Runtime
# dev = coloured console logs, prod = JSON logs (Docker sets prod)
APP_ENV=dev
# Time zone for showing times to users (storage is always UTC). Not the POSIX TZ.
DISPLAY_TZ=Asia/Tashkent
DB_PATH=data/app.db
# Backend behind the bot: "fake" = in-memory sample data (default until API keys exist),
# "real" = pipeline + scheduler (needs TELEGRAM_BOT_TOKEN, API_FOOTBALL_KEY, GEMINI_API_KEY).
APP_SERVICES=fake
# How API-Football writes Asian handicap lines (home_line | own_line). WARNING: take it from the
# F0 probe result and set it BEFORE the first real odds are stored; stored lines cannot be
# re-read, so NEVER change it afterwards. APP_SERVICES=real refuses to start while this line is
# commented out (uncommenting it with the value you verified is the confirmation).
# HANDICAP_CONVENTION=home_line
# Stake sizing of recommendations: flat (1 unit) or kelly (capped quarter Kelly of the bank).
STAKING_MODE=flat
# Extra bookmakers whose odds are stored besides Pinnacle and 1xBet (comma-separated, lower-case
# API names). Empty by default: every extra one multiplies the odds history (ADR 0018).
# INGEST_EXTRA_BOOKMAKERS=
# Weekly learning loop: off | shadow | apply. shadow (default) only journals what it WOULD change;
# apply lets it raise EV bars, disable segments and calibrate probabilities. Move to apply only
# after reviewing the shadow log (ADR 0013).
LEARNING_MODE=shadow
# Days the loop leaves a segment/calibration alone after a manual rollback.
LEARNING_MANUAL_HOLD_DAYS=30
# Days the log of API-Football and Gemini calls (what was asked, what came back) is kept.
CALL_LOG_RETENTION_DAYS=30
# Daily database refresh (local DISPLAY_TZ time; analyses read the database only, ADR 0021) and the
# shortest gap between two administrator "Bazani yangilash" runs.
REFRESH_AT=08:30
MANUAL_REFRESH_MIN_MINUTES=30
LOG_LEVEL=INFO

# Build identity (the image build bakes these in; set them only for runs outside the image)
# APP_VERSION=
# GIT_SHA=
# Minutes without a scheduler tick before the process exits with code 3 so Docker restarts it
WATCHDOG_STALL_MINUTES=10

# Monitoring (optional)
# healthchecks.io ping URL: pinged after each successful daily job (settle, refresh), /fail on
# failure. Create the check with period 1 day and a grace time of a few hours. The URL is a secret.
HEALTHCHECKS_URL=

# Behind a TLS-intercepting corporate proxy (optional, off by default; README "Korporativ proksi
# ortida"). Never disables verification. On a Windows corporate machine set the flag to true;
# otherwise point TLS_CA_BUNDLE at the exported PEM of the proxy's CA.
TLS_USE_SYSTEM_TRUST_STORE=false
TLS_CA_BUNDLE=
