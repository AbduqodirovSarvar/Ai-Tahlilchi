# Copy to .env and fill in. Never commit .env.
# Every value is optional at load time; a component that needs a missing key refuses to
# start with a clear message (e.g. the bot needs TELEGRAM_BOT_TOKEN and ADMIN_IDS).

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot
ADMIN_IDS=

# Data sources
API_FOOTBALL_KEY=
# Optional
ODDS_API_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Runtime
# dev = coloured console logs, prod = JSON logs (Docker sets prod)
APP_ENV=dev
# Time zone for showing times to users (storage is always UTC). Not the POSIX TZ.
DISPLAY_TZ=Asia/Tashkent
DB_PATH=data/app.db
# Backend behind the bot: "fake" = in-memory sample data (default until API keys exist),
# "real" = pipeline + scheduler (needs TELEGRAM_BOT_TOKEN, API_FOOTBALL_KEY, GEMINI_API_KEY).
APP_SERVICES=fake
# Stake sizing of recommendations: flat (1 unit) or kelly (capped quarter Kelly of the bank).
STAKING_MODE=flat
# Weekly learning loop: off | shadow | apply. shadow (default) only journals what it WOULD change;
# apply lets it raise EV bars, disable segments and calibrate probabilities. Move to apply only
# after reviewing the shadow log (ADR 0013).
LEARNING_MODE=shadow
# Days the loop leaves a segment/calibration alone after a manual rollback.
LEARNING_MANUAL_HOLD_DAYS=30
LOG_LEVEL=INFO

# Monitoring (optional)
# healthchecks.io ping URL: pinged after each successful daily job (settle, refresh), /fail on
# failure. Create the check with period 1 day and a grace time of a few hours. The URL is a secret.
HEALTHCHECKS_URL=
