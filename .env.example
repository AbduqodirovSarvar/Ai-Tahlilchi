# Copy to .env and fill in. Never commit .env.

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot
ADMIN_IDS=

# Data sources
API_FOOTBALL_KEY=
# Optional
ODDS_API_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Runtime
TZ=Asia/Tashkent
DB_PATH=data/app.db
LOG_LEVEL=INFO

# Monitoring (optional)
HEALTHCHECKS_URL=
